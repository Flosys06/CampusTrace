# CampusTrace Environment Configuration
PROJECT_NAME=CampusTrace
PROJECT_VERSION=1.0.0
API_V1_STR=/api

# Security (Change in production!)
SECRET_KEY=campustrace-secret-key-super-secure-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./campustrace.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/campustrace

# Matching thresholds
SIMILARITY_MATCH_THRESHOLD=0.45
HIGH_CONFIDENCE_THRESHOLD=0.70
TOP_K_MATCHES=5
