{
  "name": "campustrace-root",
  "version": "1.0.0",
  "description": "CampusTrace AI-Powered Lost & Found Management System",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --app-dir backend",
    "backend": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --app-dir backend",
    "frontend": "npm --prefix frontend run dev",
    "server": "npm run backend",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "reset-db": "python backend/setup_system.py",
    "seed": "python backend/seed.py"
  },
  "keywords": [
    "campustrace",
    "lost-and-found",
    "computer-vision",
    "ai",
    "mobile-first"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
